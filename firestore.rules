rules_version = '2';

// Barrera real de seguridad. El chequeo de la lista blanca que hace el
// navegador (js/firebase-config.js) es solo para dar un mensaje claro: se
// puede saltar. Esto no.
//
// Al añadir o quitar a alguien hay que tocar LOS DOS sitios y publicar ambos.
// La lista va en minúsculas y se compara con el email del token en minúsculas,
// igual que en el cliente.

service cloud.firestore {
  match /databases/{database}/documents {

    function autorizado() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'pantonbernal@gmail.com',
          'angels_recio@hotmail.com',
          'jrecio0086@gmail.com'
        ];
    }

    // Ajustes del usuario: objetivo de peso, altura y fecha objetivo.
    match /usuarios/{uid} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Cada usuario solo entra en sus propias subcolecciones.
    match /usuarios/{uid}/pesajes/{pesajeId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    match /usuarios/{uid}/comidas/{comidaId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Las bebidas: lo que bebes que no es agua (spec 062). Colección propia y
    // no un momento de comidas, para que no entren en el análisis nutricional.
    match /usuarios/{uid}/bebidas/{bebidaId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    match /usuarios/{uid}/ejercicios/{ejercicioId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    match /usuarios/{uid}/consejos/{consejoId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    match /usuarios/{uid}/consultas/{consultaId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    match /usuarios/{uid}/planes/{planId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    match /usuarios/{uid}/fotos/{fotoId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Recetario del usuario (spec 026). Vive fuera de las operaciones a
    // propósito: una receta es conocimiento acumulado, no el diario de una
    // etapa, así que no se archiva al cerrar una operación.
    match /usuarios/{uid}/recetas/{recetaId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // La despensa: los ingredientes que tienes en casa (spec 058). Fuera de las
    // operaciones por el mismo motivo que las recetas: empezar otra operación
    // bikini no te deja sin tomates.
    match /usuarios/{uid}/despensa/{ingredienteId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Los materiales de entrenamiento (spec 074): la despensa de Ejercicio.
    // Fuera de las operaciones por el mismo motivo que el catálogo de
    // ejercicios: no es el diario de una etapa.
    match /usuarios/{uid}/materiales/{materialId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Dietas: la semana de menús (spec 028). Como las recetas, viven fuera de
    // las operaciones: una dieta que funcionó sigue sirviendo en la siguiente.
    match /usuarios/{uid}/dietas/{dietaId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Catálogo de ejercicios (spec 029). OJO: no es la colección "ejercicios",
    // que son los registros de actividad hecha. Esto es el plan; aquello, el
    // diario. Vive fuera de las operaciones, como el recetario.
    match /usuarios/{uid}/ejerciciosCatalogo/{ejercicioId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Tablas: la semana de entrenamientos (spec 029). Como las dietas, viven
    // fuera de las operaciones: una tabla que funcionó sigue sirviendo.
    match /usuarios/{uid}/tablas/{tablaId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Detalle nutricional del día (spec 030). El id del documento es la fecha,
    // así que hay uno por día. A diferencia del recetario y del catálogo, esto
    // es diario: se archiva con la operación.
    // El agua del día (spec 061). Como analisis, la fecha es el id: un
    // documento por día, no uno por vaso.
    match /usuarios/{uid}/agua/{fecha} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    match /usuarios/{uid}/analisis/{fecha} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Operaciones: cada ciclo con principio y fin (spec 018).
    match /usuarios/{uid}/operaciones/{operacionId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Lo archivado al finalizar una operación: una subcolección por tipo de
    // registro, con los mismos documentos que había en el día a día.
    match /usuarios/{uid}/operaciones/{operacionId}/{coleccion}/{documentoId} {
      allow read, write: if autorizado() && request.auth.uid == uid;
    }

    // Todo lo demás, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
